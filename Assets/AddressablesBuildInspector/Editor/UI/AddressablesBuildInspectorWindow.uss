.abi-root {
    --abi-bg: #1E1E1E;
    --abi-panel: #252526;
    --abi-panel-elevated: #2D2D30;
    --abi-border: #3C3C3C;
    --abi-border-soft: #343438;
    --abi-primary: #4FC3F7;
    --abi-text: #D4D4D4;
    --abi-text-secondary: #9E9E9E;
    --abi-success: #4CAF50;
    --abi-info: #4FC3F7;
    --abi-warning: #FFB74D;
    --abi-danger: #EF5350;
    --abi-critical: #E53935;
    --abi-high: #FB8C00;
    --abi-medium: #FDD835;
    --abi-low: #43A047;
    flex-grow: 1;
    background-color: var(--abi-bg);
    color: var(--abi-text);
    font-size: 12px;
}

.abi-root Button,
.abi-root PopupField,
.abi-root TextField {
    color: var(--abi-text);
}

.abi-root Button {
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 4px;
    background-color: #313135;
    color: var(--abi-text);
    height: 28px;
    padding-left: 10px;
    padding-right: 10px;
}

.abi-root Button:hover {
    border-color: #5A5A60;
    background-color: #38383D;
}

.abi-toolbar {
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--abi-border);
    background-color: #1B1B1C;
}

.abi-load-button {
    min-width: 132px;
    height: 26px;
    border-color: #3F6E84;
    background-color: #244353;
}

.abi-clear-button {
    min-width: 72px;
    height: 26px;
    margin-left: 6px;
}

.abi-title-block {
    min-width: 260px;
    margin-left: 14px;
    margin-right: 14px;
}

.abi-window-title {
    color: #FFFFFF;
    font-size: 15px;
    -unity-font-style: bold;
}

.abi-window-subtitle {
    margin-top: 2px;
    color: var(--abi-text-secondary);
    font-size: 10px;
}

.abi-source-label {
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 10px;
    color: var(--abi-text-secondary);
    -unity-text-align: middle-left;
}

.abi-search-field {
    width: 260px;
}

.abi-search-field .unity-text-input,
.abi-ai-preview .unity-text-input {
    background-color: #1B1B1C;
    color: var(--abi-text);
    border-color: var(--abi-border);
}

.abi-status-label {
    min-height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--abi-border);
    background-color: #202124;
    color: var(--abi-text-secondary);
    white-space: normal;
}

.abi-status-error {
    background-color: #331F20;
    color: #FF8A80;
}

.abi-status-success {
    background-color: #1C2E22;
    color: #8FD694;
}

.abi-tab-bar {
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: #202020;
    border-bottom-width: 1px;
    border-bottom-color: var(--abi-border);
}

.abi-tab-button {
    height: 30px;
    min-width: 98px;
    margin-right: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--abi-text-secondary);
}

.abi-tab-button:hover {
    color: var(--abi-text);
    background-color: #34343A;
}

.abi-tab-button-active {
    border-color: #426171;
    background-color: #263B45;
    color: var(--abi-primary);
    -unity-font-style: bold;
}

.abi-content {
    flex-grow: 1;
    background-color: var(--abi-bg);
}

.abi-tab-content {
    flex-grow: 1;
    padding: 14px;
}

.abi-hidden {
    display: none;
}

.abi-overview-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.abi-kpi-row {
    margin-bottom: 10px;
    flex-shrink: 0;
}

.abi-section-title {
    flex-shrink: 0;
    margin-top: 2px;
    margin-bottom: 8px;
}

.abi-section-title-label {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
}

.abi-section-title-subtitle {
    margin-top: 2px;
    color: var(--abi-text-secondary);
    font-size: 10px;
}

.abi-stat-card {
    min-width: 190px;
    max-width: 300px;
    min-height: 104px;
    flex-grow: 1;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 12px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel);
}

.abi-stat-card:hover {
    border-color: #56565C;
    background-color: var(--abi-panel-elevated);
}

.abi-health-card {
    min-width: 300px;
    max-width: 360px;
    min-height: 142px;
    border-left-width: 4px;
    background-color: var(--abi-panel-elevated);
}

.abi-card-success {
    border-left-width: 4px;
    border-left-color: var(--abi-success);
}

.abi-card-warning {
    border-left-width: 4px;
    border-left-color: var(--abi-warning);
}

.abi-card-danger {
    border-left-width: 4px;
    border-left-color: var(--abi-danger);
}

.abi-stat-label {
    color: var(--abi-text-secondary);
    font-size: 10px;
    -unity-font-style: bold;
}

.abi-stat-value {
    margin-top: 10px;
    color: #FFFFFF;
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.abi-health-body {
    margin-top: 10px;
    flex-direction: row;
    align-items: center;
}

.abi-health-ring {
    width: 74px;
    height: 74px;
    border-width: 6px;
    border-radius: 37px;
    align-items: center;
    justify-content: center;
    background-color: #202124;
}

.abi-health-ring-success {
    border-color: var(--abi-success);
}

.abi-health-ring-warning {
    border-color: var(--abi-warning);
}

.abi-health-ring-danger {
    border-color: var(--abi-danger);
}

.abi-health-score {
    color: #FFFFFF;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.abi-health-copy {
    margin-left: 14px;
    flex-grow: 1;
}

.abi-health-value {
    color: #FFFFFF;
    font-size: 26px;
    -unity-font-style: bold;
}

.abi-health-state {
    margin-top: 4px;
    color: var(--abi-text-secondary);
    font-size: 12px;
    -unity-font-style: bold;
}

.abi-stat-meta {
    margin-top: 8px;
    color: var(--abi-text-secondary);
    font-size: 10px;
    white-space: normal;
}

.abi-top-offenders {
    flex-shrink: 0;
    margin-top: 4px;
    padding: 12px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel-elevated);
}

.abi-top-offenders-header,
.abi-top-offender-row {
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--abi-border-soft);
}

.abi-top-offenders-header {
    background-color: #303036;
}

.abi-top-offender-row:hover {
    background-color: #303036;
}

.abi-top-offender-cell {
    min-width: 0;
    flex-basis: 0;
    flex-shrink: 1;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--abi-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.abi-insight-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.abi-insight-card {
    min-width: 260px;
    min-height: 108px;
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 12px;
    flex-direction: row;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel);
}

.abi-insight-card:hover {
    border-color: #4E5E66;
    background-color: var(--abi-panel-elevated);
}

.abi-insight-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 16px;
    background-color: #244353;
    color: var(--abi-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.abi-insight-content {
    flex-grow: 1;
    min-width: 0;
}

.abi-insight-title {
    color: #FFFFFF;
    font-size: 13px;
    -unity-font-style: bold;
}

.abi-insight-body {
    margin-top: 5px;
    color: var(--abi-text);
    white-space: normal;
}

.abi-insight-severity {
    align-self: flex-start;
    margin-top: 8px;
    margin-left: 0;
}

.abi-table-header {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding-right: 14px;
    border-width: 1px;
    border-color: var(--abi-border);
    background-color: #2D2D30;
}

.abi-header-button {
    height: 32px;
    min-width: 0;
    flex-basis: 0;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    color: var(--abi-text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.abi-header-button:hover {
    background-color: rgba(79, 195, 247, 0.12);
    color: #FFFFFF;
}

.abi-header-button-numeric {
    -unity-text-align: middle-right;
}

.abi-list-view {
    flex-grow: 1;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--abi-border);
    border-right-color: var(--abi-border);
    border-bottom-color: var(--abi-border);
    background-color: #202020;
}

.abi-list-view .unity-collection-view__item {
    background-color: #222224;
}

.abi-list-view .unity-collection-view__item--alternative-background {
    background-color: #252526;
}

.abi-list-view .unity-collection-view__item:hover {
    background-color: #30343A;
}

.abi-list-view .unity-collection-view__item--selected,
.abi-list-view .unity-list-view__item--selected {
    background-color: #17384A;
    border-left-width: 3px;
    border-left-color: var(--abi-primary);
}

.abi-list-view .unity-collection-view__item--selected .abi-table-row,
.abi-list-view .unity-list-view__item--selected .abi-table-row {
    background-color: #17384A;
}

.abi-table-row {
    height: 32px;
    width: 100%;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 0;
    background-color: transparent;
}

.abi-row-warning {
    border-left-width: 3px;
    border-left-color: var(--abi-warning);
}

.abi-cell {
    min-width: 0;
    flex-basis: 0;
    flex-shrink: 1;
    padding-left: 8px;
    padding-right: 8px;
    color: #DADADA;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.abi-cell-number {
    -unity-text-align: middle-right;
}

.abi-cell-danger {
    color: #FFB3A8;
    -unity-font-style: bold;
}

.abi-severity-pill {
    height: 20px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.abi-severity-critical {
    color: #FFFFFF;
    background-color: #5B1E20;
    border-color: var(--abi-critical);
}

.abi-severity-high {
    color: #FFE4C2;
    background-color: #4C2D10;
    border-color: var(--abi-high);
}

.abi-severity-medium {
    color: #FFF6B8;
    background-color: #443A12;
    border-color: var(--abi-medium);
}

.abi-severity-low {
    color: #C8F6CD;
    background-color: #1D3D22;
    border-color: var(--abi-low);
}

.abi-empty-state {
    padding: 18px;
    color: var(--abi-text-secondary);
    white-space: normal;
    background-color: var(--abi-panel);
}

.abi-loading-state {
    min-height: 72px;
    flex-grow: 1;
    margin-bottom: 8px;
    padding: 14px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 6px;
    background-color: var(--abi-panel);
}

.abi-loading-label {
    margin-bottom: 10px;
    color: var(--abi-text);
    -unity-font-style: bold;
}

.abi-loading-track {
    height: 6px;
    border-radius: 3px;
    background-color: #35353A;
    overflow: hidden;
}

.abi-loading-fill {
    position: absolute;
    left: -28%;
    width: 28%;
    height: 6px;
    border-radius: 3px;
    background-color: var(--abi-primary);
}

.abi-dependency-layout {
    flex-grow: 1;
    flex-direction: row;
}

.abi-dependency-panel {
    width: 42%;
    min-width: 260px;
    margin-right: 8px;
}

.abi-dependency-detail-layout {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
}

.abi-dependency-section {
    flex-grow: 1;
    min-width: 260px;
    margin-right: 8px;
}

.abi-dependency-scroll,
.abi-dependency-detail-scroll {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-color: var(--abi-border);
    background-color: var(--abi-panel);
}

.abi-dependency-detail-scroll {
    width: 280px;
    min-width: 220px;
}

.abi-dependency-tree,
.abi-dependency-details {
    padding: 8px;
}

.abi-dependency-reference {
    min-width: 0;
    margin-bottom: 6px;
    padding: 6px;
    border-width: 1px;
    border-color: var(--abi-border-soft);
    border-radius: 4px;
    background-color: #202124;
    color: var(--abi-text);
    white-space: normal;
}

.abi-dependency-foldout {
    margin-left: 2px;
    margin-bottom: 2px;
}

.abi-node-icon-duplicate,
.abi-node-icon-shared,
.abi-node-icon-large,
.abi-node-icon-missing,
.abi-node-icon-broken,
.abi-node-icon-circular {
    border-left-width: 3px;
}

.abi-node-icon-duplicate {
    border-left-color: var(--abi-warning);
}

.abi-node-icon-shared {
    border-left-color: var(--abi-info);
}

.abi-node-icon-large {
    border-left-color: var(--abi-high);
}

.abi-node-icon-missing,
.abi-node-icon-broken,
.abi-node-icon-circular {
    border-left-color: var(--abi-danger);
}

.abi-detail-row {
    margin-bottom: 9px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--abi-border-soft);
}

.abi-detail-label {
    color: var(--abi-text-secondary);
    font-size: 10px;
    -unity-font-style: bold;
}

.abi-detail-value {
    color: var(--abi-text);
    white-space: normal;
}

.abi-detail-heading {
    margin-top: 8px;
    margin-bottom: 5px;
    color: var(--abi-text);
    -unity-font-style: bold;
}

.abi-pane-heading {
    min-height: 24px;
    margin-bottom: 8px;
    color: #FFFFFF;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.abi-optimization-controls,
.abi-diff-controls {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding: 8px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel);
}

.abi-optimization-controls Button,
.abi-diff-controls Button {
    min-height: 26px;
    margin-right: 6px;
}

.abi-optimization-insights,
.abi-diff-insights {
    flex-shrink: 0;
    margin-top: 2px;
    margin-bottom: 10px;
    padding: 12px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel-elevated);
}

.abi-optimization-insights-scroll {
    height: 150px;
    min-height: 110px;
    max-height: 180px;
    flex-shrink: 0;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel-elevated);
}

.abi-optimization-insights-scroll .abi-optimization-insights {
    margin-bottom: 0;
    border-width: 0;
    background-color: transparent;
}

.abi-optimization-insights .abi-section-title {
    margin-bottom: 6px;
}

.abi-optimization-insights .abi-insight-card {
    min-height: 76px;
}

.abi-optimization-layout {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 220px;
    flex-direction: row;
}

.abi-optimization-table-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 360px;
    margin-right: 10px;
    padding: 10px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel);
}

.abi-optimization-table-panel .abi-list-view {
    min-height: 0;
}

.abi-optimization-details-scroll {
    width: 360px;
    min-width: 250px;
    min-height: 0;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel-elevated);
}

.abi-optimization-details {
    padding: 12px;
    border-width: 0;
    background-color: transparent;
    white-space: normal;
}

.abi-optimization-details .unity-label {
    white-space: normal;
}

.abi-optimization-summary-card {
    margin-bottom: 12px;
    padding: 12px;
    border-width: 1px;
    border-color: #426171;
    border-radius: 5px;
    background-color: #202A30;
}

.abi-optimization-summary-title {
    color: #FFFFFF;
    -unity-font-style: bold;
    white-space: normal;
}

.abi-optimization-summary-value {
    margin-top: 8px;
    color: var(--abi-primary);
    font-size: 26px;
    -unity-font-style: bold;
}

.abi-optimization-summary-meta {
    margin-top: 5px;
    color: var(--abi-text-secondary);
    white-space: normal;
}

.abi-diff-path-label {
    min-width: 120px;
    margin-left: 6px;
    margin-right: 10px;
    color: var(--abi-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.abi-diff-overview {
    min-height: 90px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.abi-diff-stat-grid {
    min-height: 76px;
    flex-wrap: nowrap;
}

.abi-diff-stat-card {
    min-width: 0;
    max-width: none;
    min-height: 72px;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    overflow: hidden;
}

.abi-diff-stat-value {
    font-size: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.abi-diff-table-layout {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 220px;
    flex-direction: row;
}

.abi-diff-table-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 280px;
    margin-right: 10px;
    padding: 10px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel);
}

.abi-diff-table-panel .abi-list-view {
    min-height: 0;
}

.abi-diff-insights-scroll {
    height: 112px;
    min-height: 86px;
    max-height: 128px;
    flex-shrink: 0;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel-elevated);
}

.abi-diff-insights-scroll .abi-diff-insights {
    margin-bottom: 0;
    border-width: 0;
    background-color: transparent;
}

.abi-diff-insights .abi-section-title {
    margin-bottom: 4px;
}

.abi-diff-insights .abi-insight-card {
    min-height: 70px;
    margin-bottom: 8px;
}

.abi-diff-growth-scroll {
    height: 96px;
    flex-shrink: 0;
    margin-top: 8px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 6px;
    background-color: var(--abi-panel);
}

.abi-diff-growth-details {
    padding: 8px;
    white-space: normal;
}

.abi-diff-growth-details .unity-label {
    color: var(--abi-text);
    white-space: normal;
}

.abi-ai-header {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 12px;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel-elevated);
}

.abi-ai-controls {
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.abi-ai-mode-field {
    width: 320px;
    min-width: 260px;
    margin-right: 8px;
    flex-shrink: 0;
}

.abi-ai-action-button {
    min-width: 112px;
    height: 26px;
    margin-right: 6px;
    flex-shrink: 0;
}

.abi-ai-action-button-wide {
    min-width: 148px;
    height: 26px;
    margin-right: 6px;
    flex-shrink: 0;
}

.abi-ai-description {
    margin-top: 7px;
    color: var(--abi-text-secondary);
    white-space: normal;
}

.abi-ai-output {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-color: var(--abi-border);
    border-radius: 5px;
    background-color: var(--abi-panel);
}

.abi-ai-scroll {
    flex-grow: 1;
    min-height: 0;
    border-width: 0;
    background-color: transparent;
}

.abi-ai-preview {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    white-space: normal;
}

.abi-ai-preview .unity-text-input {
    min-height: 0;
    border-width: 0;
    background-color: #1B1B1C;
    color: var(--abi-text);
    white-space: normal;
}

.abi-diff-added {
    border-left-width: 3px;
    border-left-color: var(--abi-info);
}

.abi-diff-removed {
    border-left-width: 3px;
    border-left-color: var(--abi-danger);
}

.abi-diff-increased {
    border-left-width: 3px;
    border-left-color: var(--abi-warning);
}

.abi-diff-decreased {
    border-left-width: 3px;
    border-left-color: var(--abi-success);
}
